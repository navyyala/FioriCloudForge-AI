<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form" xmlns:l="sap.ui.layout" xmlns:ui="sap.suite.ui.commons"
	xmlns="sap.m">
	<Dialog id="searchArticleDialog" title="{i18n>fragmentSearchArticleTitle}" resizable="true" contentWidth="100%" contentHeight="100%">
		<content>
			<Panel class="sapUiResponsiveMargin" expandable="true" expanded="true" headerText="{i18n>headingFilter}" width="auto" height="auto">
				<headerToolbar>
					<Toolbar>
						<Title text="{i18n>fragmentSearchArticleTitle}" />
						<ToolbarSeparator/>
						<HBox alignItems="Center" justifyContent="Center">
							<Label text="{i18n>textFragmentLblStorageLocation}" class="sapUiSmallMarginEnd"/>
							<Input id="storageLocation" valueHelpOnly="false" showValueHelp="true" width="60%" valueHelpRequest="onStorageLocVH"/>
							<Text id="storageLocationDesc"/>
							<Button class="sapUiSmallMargin" press="performSearch" text="{i18n>textBtnSearch}" type="Emphasized" width="10em"/>
							<Button class="sapUiSmallMargin" press="resetSearch" text="{i18n>textBtnReset}" type="Emphasized" width="10em"/>
						</HBox>
					</Toolbar>
				</headerToolbar>
				<!-- filtres de recherche -->
				<FlexBox alignItems="Start" justifyContent="Start" height="100%">
					<items>
						<VBox class="sapUiSmallMargin">
							<Label text="{i18n>libColArticle}"/>
							<Input id="material"/>
						</VBox>
						<VBox class="sapUiSmallMargin">
							<Label text="{i18n>textFragmentLblMaterialDesc}"/>
							<Input id="materialDesc"/>
						</VBox>
						<VBox class="sapUiSmallMargin">
							<Label text="{i18n>textFragmentLblManf}"/>
							<Input id="manf"/>
						</VBox>
						<VBox class="sapUiSmallMargin">
							<Label text="{i18n>textFragmentLblManfRef}"/>
							<Input id="manfPart"/>
						</VBox>
						<VBox class="sapUiSmallMargin">
							<Label text="{i18n>textFragmentLblOldPartNum}"/>
							<Input id="oldPartNum"/>
						</VBox>
						<!--<VBox class="sapUiSmallMargin">-->
						<!--	<Button class="sapUiSmallMargin" press="performSearch" text="{i18n>textBtnSearch}" type="Emphasized" width="10em"/>-->
						<!--</VBox>-->
						<!--<VBox class="sapUiSmallMargin">-->
						<!--	<Button class="sapUiSmallMargin" press="resetSearch" text="{i18n>textBtnReset}" type="Emphasized" width="10em"/>-->
						<!--</VBox>-->
						<!-- Start JII-7074  -->
                        <!--  New Condition row  -->
                        <VBox class="sapUiSmallMargin">
                            <Label text="{i18n>textFragmentLblCondition}"/>
                            <Input id="condition"/>
                        </VBox>
                        <!-- End JII-7074  -->
					</items>
				</FlexBox>
			</Panel>
			<Table id="table" items="{/MRO_LISTSet}" growing="true" growingScrollToLoad="true">
				<columns>
					<Column id="colArticle">
						<Text text="{i18n>libColArticle}"/>
					</Column>
					<Column id="colDescription">
						<Text text="{i18n>libColDescription}"/>
					</Column>
					<Column id="colQuantite">
						<Text text="{i18n>libColQuantite}"/>
					</Column>
					<Column id="colUnit">
						<Text text="{i18n>libColUnit}"/>
					</Column>
					    <!--  New Condition column  -->
                    <!-- Start JII-7074  -->
                    <Column id="colCondition">
                        <Text text="{i18n>textFragmentLblCondition}"/>
                    </Column>
                    <!-- End JII-7074  -->
					<Column id="colStorageLoc">
						<Text text="{i18n>libColStorageLoc}"/>
					</Column>
					<Column id="colStorageBin">
						<Text text="{i18n>libColStorageBin}"/>
					</Column>
					<Column id="colManufacturer">
						<Text text="{i18n>libColManufacturer}"/>
					</Column>
					<Column id="colManfPartNumber">
						<Text text="{i18n>libColManufPartNumber}"/>
					</Column>
					<Column id="colOldPartNumber">
						<Text text="{i18n>textFragmentLblOldPartNum}"/>
					</Column>
					<Column id="colReorderingPoint">
						<Text text="{i18n>libColReorderingPoint}"/>
					</Column>
					<Column id="colStockMaxi">
						<Text text="{i18n>libColStockMaxi}"/>
					</Column>
					<Column id="colStockCriticalPart">
						<Text text="{i18n>libColCriticalPart}"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem press="onPress" type="Navigation">
						<cells>
							<Text text="{Matnr}"/>
							<!--<Text text="{path:'Matnr', formatter:'.removeLeadingP'}"/>-->
							<Text text="{Maktx}"/>
							<Text text="{
								    path: 'Labst',
								    formatter: '.stockOutputHelper.removeQuantityDecimals'
								}" />
							<Text text="{Meins}"/>
	<!-- Start JII-7074 --> <Text text="{Bwtar}"/>      <!-- End JII-7074  -->  
							<Text text="{Lgort}"/>
							<Text text="{Lgpbe}"/>
							<Text text="{ZMfrnr}"/>
							<Text text="{ZMfrpn}"/>
							<Text text="{ZzOldMatnr}"/>
							<Text text="{Minbe}"/>
							<Text text="{Mabst}"/>
							<Text text="{Kzkri}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button press="filterArticles" text="{i18n>textBtnSearch}"/>
		</beginButton>
		<endButton>
			<Button press="closeSearchDialog" text="{i18n>textBtnCancel}"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>