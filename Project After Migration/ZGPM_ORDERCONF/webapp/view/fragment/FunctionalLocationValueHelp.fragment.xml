<!-- Start JII-3786 -->
<core:FragmentDefinition xmlns:core="sap.ui.core"
	xmlns="sap.m"
	xmlns:cust="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog contentHeight="100%" contentWidth="30%"
		title="{i18n>fragmenttitlePoste}">
		<Bar id="searchBar">
			<contentLeft>
				<!--<Button icon="sap-icon://home" id="btn_home" press="onHome"/> -->
				<Button icon="sap-icon://refresh" id="btn_refresh" press="onFuncLocRefreshList" />
			</contentLeft>
			<contentMiddle>
				<SearchField id="searchField" placeholder="{i18n>searchText}"
					search="onFuncLocSearch" tooltip="{i18n&gt;masterSearchTooltip}" width="100%" />
			</contentMiddle>
		</Bar>
		<content>
			<!--Navigation path list-->
			<List class="listNav" id="listNav" items="{path: '/FUNCPARENTSet'}" mode="{device&gt;/listMode}" noDataText=" " select="onSelectNav">
				<items id="navList">
					<ObjectListItem counter="0" cust:name="{Name}" cust:level="{Level}" cust:base64="{Base64}" id="navListItem" markFavorite="false"
						markFlagged="false" number="" numberUnit="" press="onSelectNav" showMarkers="false" title="{Description}" type="{device&gt;/listItemType}"></ObjectListItem>
				</items>
			</List>
			<!--Navigation main list-->
			<List id="list" mode="{device>/listMode}" items="{path: '/FUNCLEVELSet'}" noDataText="{i18n>masterListNoDataText}" select="onSelect" updateFinished="onFuncUpdated">
				<items id="masterList">
					<ObjectListItem counter="0" cust:lowerLevel="{LowerLevel}" cust:orderAllowed="{OrderAllowed}" cust:objType="{ObjType}" cust:color="{Color}"
						id="mainListItem" cust:base64="{Base64}" markFavorite="false" markFlagged="false" number="" numberUnit="" press="onSelect"
						showMarkers="false" title="{Description}" type="{device&gt;/listItemType}"></ObjectListItem>
				</items>
			</List>
		</content>
		<beginButton>
			<Button text="OK" press="onFuncLocValueHelpOK" /> 		
			</beginButton>
		<endButton>
			<Button text="Cancel" press="onFuncLocValueHelpClose" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>

<!--End JII-3786 -->