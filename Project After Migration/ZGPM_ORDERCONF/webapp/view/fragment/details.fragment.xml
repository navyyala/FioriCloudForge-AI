					<!--<Text text="{Priok} {Prioktxt}"  class="sapUiTinyMargin"/>-->
					<ComboBox items="{ path: '/PRIORITYSet' }" selectedKey="{Priok}" class="inputsAndCombos" editable="false">
						<core:Item key="{Prior}" text="{Prior} {Description}"/>
					</ComboBox>
					<!--<Label text="{i18n>textFragmentLblWorkType}" class="sapUiTinyMargin"/>-->
